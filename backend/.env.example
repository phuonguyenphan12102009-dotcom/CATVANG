# Sao chép file này thành .env rồi điền giá trị thật vào — KHÔNG BAO GIỜ commit file .env thật lên GitHub

# Cổng chạy server Express (Render sẽ tự cấp PORT riêng, biến này chỉ cần cho local)
PORT=3000

# Chuỗi kết nối MongoDB Atlas — lấy từ Atlas > Connect > Drivers
# Nhớ thêm /ten_database?retryWrites=true&w=majority vào cuối
MONGODB_USERNAME="puyen8698_db_user"
MONGODB_PASSWORD="allXCIi1U8Syr4dh"
MONGODB_URI="mongodb+srv://puyen8698_db_user:allXCIi1U8Syr4dh@cluster0.8oqkfnw.mongodb.net"
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/khmer_museum?retryWrites=true&w=majority

# Khoá bí mật để ký JWT — tự tạo bằng lệnh:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-that-dai-cua-rieng-ban

# Tài khoản admin khởi tạo (chỉ dùng 1 lần khi chạy `npm run create-admin`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay
ADMIN_FULLNAME=Quản trị viên Bảo tàng số

# Domain frontend thật sau khi deploy Vercel (cách nhau bằng dấu phẩy nếu có nhiều domain)
# Để trống khi chạy local để CORS cho phép tất cả.
FRONTEND_URL=https://ten-du-an-cua-ban.vercel.app
